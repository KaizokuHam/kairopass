{
  "name": "@kairopass/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/database.integration.test.ts",
    "test:db": "vitest run tests/database.integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mongoose": "9.11.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
