{
  "name": "kairopass",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack event booking platform with simulated payments, secure QR ticketing, and organizer analytics.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24.14.0 <25", "npm": ">=11" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces",
    "test:web": "npm run test -w client",
    "test:unit": "npm run test:unit -w server",
    "test:db": "npm run test:db -w server",
    "test:auth": "npm run test:auth -w server",
    "test:events": "npm run test:events -w server",
    "test:watch": "npm run test:watch -w server",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
