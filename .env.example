# Copy to .env in the repository root. Never commit .env.
# The web shell and liveness work without MongoDB; readiness requires a replica set.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Vite's proxy target; only read by the development build tool.
API_PROXY_TARGET=http://127.0.0.1:4000
LOG_LEVEL=info

# Local MongoDB must be started with --replSet rs0 and initialized (see docs/database.md).
# In production supply an Atlas mongodb+srv:// URI through the environment.
MONGODB_URI=mongodb://127.0.0.1:27017/kairopass?replicaSet=rs0
# Reserved for authentication. Generate independent random secrets of 32+ bytes.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_AUTHENTICATION
JWT_EXPIRES_IN=15m
COOKIE_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
# Production will require HTTPS and secure HTTP-only cookies.
COOKIE_SECURE=false
