# Copy to .env in the repository root. Never commit .env.
# The web shell and liveness work without MongoDB; readiness requires a replica set.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Vite's proxy target; only read by the development build tool.
API_PROXY_TARGET=http://127.0.0.1:4000
LOG_LEVEL=info

# Local MongoDB must be started with --replSet rs0 and initialized (see docs/database.md).
# In production supply an Atlas mongodb+srv:// URI through the environment.
MONGODB_URI=mongodb://127.0.0.1:27017/kairopass?replicaSet=rs0
# Required for authentication: generate a fresh unpadded base64url value locally:
# node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
# Paste the result into your ignored .env; never commit it or put it in VITE_*.
# Missing/weak/placeholder values disable auth with HTTP 503; liveness stays available.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_AUTHENTICATION
JWT_EXPIRES_IN=12h
JWT_ISSUER=kairopass-api
JWT_AUDIENCE=kairopass-web
# Explicit API/browser origin. Production requires your actual HTTPS origin here.
APP_ORIGIN=http://127.0.0.1:4000
# Per-IP limits in separate 15-minute in-memory windows.
AUTH_LOGIN_MAX_REQUESTS=10
AUTH_REGISTER_MAX_REQUESTS=5
# Cookie Secure is derived from NODE_ENV; it cannot be disabled in production.
